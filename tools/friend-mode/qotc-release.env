# Quest of the Companions release builds: the services every build we hand
# out talks to (qotcservices.h).  Read by configure
# (--with-qotc-services=tools/friend-mode/qotc-release.env), Makefile.mingw
# (QOTC_SERVICES=tools/friend-mode/qotc-release.env) and the Windows
# workflow, so it is both shell and make: NAME=value, no spaces or quotes.
#
# These are built into every install: never change them, or installed builds
# stop finding their updates.  None of them is a secret.  Someone making
# their own builds writes their own file (docs/friend-mode/updates.md).

# The update feeds (tools/downloads/deploy.sh writes them).
QOTC_FEED_MACOS=https://downloads.xcast3d.com/u7-qotc/appcast-macos.xml
QOTC_FEED_WINDOWS=https://downloads.xcast3d.com/u7-qotc/appcast-windows.xml

# The public half of the key that signs updates.  The private half is never
# in the repository (docs/friend-mode/updates.md, "The signing key").
QOTC_UPDATE_KEY=0yHVSoBe8ELk7KcI/CkUiW4dHvXbtCVbbor4rA99/4w=

# The Windows installer's AppId (win32/qotc_installer.iss): how an update
# finds the install it replaces.
QOTC_APPID=32D331D8-FE01-4298-9106-FC08CC6A3832

# The lobby: not set here, so qotcservices.h's default (ours).
# QOTC_LOBBY_URL=wss://u7-multiplayer-lobby.xcast3d.com
